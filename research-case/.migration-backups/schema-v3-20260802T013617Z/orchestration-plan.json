  "loop_outcomes": {
    "NOVELTY_AUDIT": {
      "NOVELTY_UNRESOLVED": {
        "action": "RETRY",
        "target": "NOVELTY_AUDIT",
        "next_action": "Extend the reproducible prior-art search or obtain missing sources, then rerun the novelty audit."
      },
      "REFRAME": {
        "action": "INVALIDATE",
        "target": "NOVELTY_AUDIT",
        "next_action": "Reframe or narrow the contribution within the recorded intake; revise the intake and invalidate INTAKE if the research question changes materially."
      },
      "STOP": {
        "action": "STOP",
        "target": "NOVELTY_AUDIT",
        "next_action": "Preserve the defeated novelty case and negative evidence; do not continue toward a manuscript claim."
      }
    },
    "FEASIBILITY_GATE": {
      "PILOT_FIRST": {
        "action": "RETRY",
        "target": "FEASIBILITY_GATE",
        "next_action": "Freeze pilot authority, protocol, and green/amber/red criteria; run only the authorized feasibility pilot, then reassess feasibility."
      },
      "REDESIGN": {
        "action": "INVALIDATE",
        "target": "NOVELTY_AUDIT",
        "next_action": "Redesign the proposal from the novelty and causal-model stage, then rerun feasibility."
      },
      "BLOCKED": {
        "action": "BLOCK",
        "target": "FEASIBILITY_GATE",
        "next_action": "Resolve the named authority, ethics, safety, access, validity, resource, or value blocker before resuming."
      },
      "RESUME": {
        "action": "RESUME",
        "target": "FEASIBILITY_GATE",
        "next_action": "Reassess feasibility using verified evidence that the recorded blockers are resolved."
      },
      "STOP": {
        "action": "STOP",
        "target": "FEASIBILITY_GATE",
        "next_action": "Preserve the feasibility failure and stop the research program."
      }
    },
    "ADVERSARIAL_QA": {
      "REMEDIATE": {
        "action": "INVALIDATE",
        "target": "ADVERSARIAL_QA",
        "next_action": "Apply the smallest evidence-bound remediation and rerun every affected killer question."
      },
      "STOP": {
        "action": "STOP",
        "target": "ADVERSARIAL_QA",
        "next_action": "Preserve the fatal review findings and do not promote the submission package."
      }
    }
  },
