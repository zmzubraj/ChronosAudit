# Managed archive RPC credentials. Values stay in the local untracked .env.
# The workflow expands these keys only through frozen per-chain HTTPS templates.
CHRONOS_ALCHEMY_API_KEY=
CHRONOS_INFURA_API_KEY=

# Optional explicit endpoint override. When any URL list is set, the matching
# provider-family list is mandatory, must have the same length, and must resolve
# to at least two distinct independently verified operator families. URL-only
# configuration fails closed. Explicit URLs take precedence over managed keys.
CHRONOS_ETHEREUM_ARCHIVE_RPC_URLS=
CHRONOS_ETHEREUM_ARCHIVE_RPC_PROVIDER_FAMILIES=
CHRONOS_BSC_ARCHIVE_RPC_URLS=
CHRONOS_BSC_ARCHIVE_RPC_PROVIDER_FAMILIES=
CHRONOS_BASE_ARCHIVE_RPC_URLS=
CHRONOS_BASE_ARCHIVE_RPC_PROVIDER_FAMILIES=
CHRONOS_ARBITRUM_ARCHIVE_RPC_URLS=
CHRONOS_ARBITRUM_ARCHIVE_RPC_PROVIDER_FAMILIES=
