{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosaudit.org/schemas/strict-historical-snapshot-v1.json",
  "title": "ChronosAudit Strict Historical Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "case_name",
    "chain",
    "address",
    "case_input",
    "case_input_sha256",
    "policy_input",
    "policy_sha256",
    "provider_identity",
    "provider_identity_sha256",
    "provider_families",
    "deployment_block",
    "deployment_timestamp",
    "prediction_cutoff_policy",
    "prediction_cutoff_target_timestamp",
    "prediction_cutoff_block",
    "prediction_cutoff_timestamp",
    "prediction_cutoff_block_hash",
    "incident_block",
    "incident_timestamp",
    "cutoff_lead_hours",
    "deployment_transition",
    "cutoff_bracket",
    "incident_block_consensus",
    "snapshot",
    "state_cells",
    "receipt_bindings",
    "required_state_cells",
    "strict_snapshot_closed",
    "blockers",
    "artifact_sha256_without_self_hash",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": "chronosaudit-strict-historical-snapshot-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "case_name": { "type": "string", "minLength": 1 },
    "chain": { "type": "string", "minLength": 1 },
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "case_input": { "type": "object" },
    "case_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_input": { "type": "object" },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_identity": { "type": "object" },
    "provider_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_families": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "deployment_block": { "type": "integer", "minimum": 0 },
    "deployment_timestamp": { "type": "integer", "minimum": 0 },
    "prediction_cutoff_policy": { "type": "string", "minLength": 1 },
    "prediction_cutoff_target_timestamp": { "type": "integer", "minimum": 0 },
    "prediction_cutoff_block": { "type": "integer", "minimum": 0 },
    "prediction_cutoff_timestamp": { "type": "integer", "minimum": 0 },
    "prediction_cutoff_block_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "incident_block": { "type": "integer", "minimum": 0 },
    "incident_timestamp": { "type": "integer", "minimum": 0 },
    "cutoff_lead_hours": { "type": "number", "minimum": 0 },
    "deployment_transition": { "type": "object" },
    "cutoff_search": { "type": "object" },
    "cutoff_bracket": { "type": "object" },
    "incident_block_consensus": { "type": "object" },
    "snapshot": { "type": "object" },
    "state_cells": { "type": "object" },
    "receipt_bindings": { "type": "object" },
    "required_state_cells": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "strict_snapshot_closed": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact_sha256_without_self_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strict_snapshot_validation": { "type": "object" }
  },
  "additionalProperties": true
}
